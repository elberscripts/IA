{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sombra.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "move"
          ],
          "transitions": [
            {
              "idle": "!query.is_moving"
            }
          ]
        },
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "default": "query.is_moving"
            }
          ]
        }
      }
    }
  }
}